{
  "name": "halbot",
  "description": "Just another AI powered Telegram bot, which is simple design, easy to use, extendable and fun.",
  "version": "1995.1.66",
  "private": false,
  "homepage": "https://github.com/Leask/halbot",
  "type": "module",
  "engines": {
    "node": ">=20.x"
  },
  "main": "index.mjs",
  "bin": {
    "halbot": "bin/halbot.mjs"
  },
  "scripts": {
    "start": "node bin/halbot.mjs",
    "debug": "node --inspect --trace-warnings debug.mjs",
    "test": "node --trace-warnings test.mjs",
    "updep": "npx npm-check-updates -u && npm install",
    "gitsync": "( git commit -am \"Released @ `date`\" || true ) && git pull && git push",
    "build": "npm run updep && ( git commit -am 'update dependencies' || true )",
    "pub": "npm run build && npm run gitsync",
    "beta": "npm publish --tag beta",
    "test:security": "node --test tests/security-dependencies.test.mjs"
  },
  "author": "Leask Wong <i@leaskh.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leask/halbot.git"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google-cloud/discoveryengine": "^3.2.0",
    "@google/genai": "^2.23.0",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "fluent-ffmpeg": "^2.1.3",
    "google-gax": "^6.4.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.0",
    "lorem-ipsum": "^3.0.0",
    "mime": "^4.1.0",
    "mysql2": "^3.24.4",
    "office-text-extractor": "^4.0.0",
    "openai": "^7.17.0",
    "parse-numeric-range": "^1.3.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "satori": "^0.33.4",
    "telegraf": "^4.16.3",
    "tellegram": "^1.1.18",
    "tesseract.js": "^7.0.0",
    "webjam": "^1995.3.25",
    "youtube-transcript": "^1.3.1"
  },
  "allowScripts": {
    "@ffmpeg-installer/darwin-arm64@4.1.5": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "tesseract.js@7.0.0": true,
    "@google/genai@2.23.0": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "fflate@>=0.7.0 <0.8.0": "^0.7.5",
    "fflate@>=0.8.0 <0.9.0": "^0.8.3",
    "file-type@>=21.0.0 <22.0.0": "^21.3.2",
    "js-yaml@>=4.0.0 <5.0.0": "^4.3.2"
  }
}
